; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Mission Arestemis"
config/description="Explore Hyperion, choose a mission and carry your designs between engineering stations."
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/main_scene.qa="res://tests/stage_two_test.tscn"

[audio]

default_bus_layout="res://default_bus_layout.tres"

[autoload]

GameState="*res://scripts/gameplay/game_state.gd"
GameAudio="*res://scripts/game_audio.gd"
SettingsStore="*res://scripts/settings_store.gd"
SceneManager="*res://scripts/scene_manager.gd"
SaveStore="*res://scripts/save_store.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/size/min_width=960
window/size/min_height=540

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg")

[gui]

theme/custom="res://themes/ui_theme.tres"

